+// [distllm patch] detect a peer that vanished without closing the connection
+// (Wi-Fi drop, device asleep): ~5 s idle, then 3 probes 2 s apart.
+static void set_keepalive(sockfd_t sockfd) {
+#ifndef _WIN32
+    int on = 1, idle = 5, intvl = 2, cnt = 3;
+    setsockopt(sockfd, SOL_SOCKET, SO_KEEPALIVE, (char *)&on, sizeof(on));
+#if defined(__APPLE__)
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPALIVE, (char *)&idle, sizeof(idle));
+#elif defined(TCP_KEEPIDLE)
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPIDLE, (char *)&idle, sizeof(idle));
+#endif
+#if defined(TCP_KEEPINTVL)
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPINTVL, (char *)&intvl, sizeof(intvl));
+#endif
+#if defined(TCP_KEEPCNT)
+    setsockopt(sockfd, IPPROTO_TCP, TCP_KEEPCNT, (char *)&cnt, sizeof(cnt));
+#endif
+#else
+    (void) sockfd;
+#endif
+}
