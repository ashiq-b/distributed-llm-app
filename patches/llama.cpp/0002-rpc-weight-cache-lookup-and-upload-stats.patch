+
+// [distllm patch] Server: another place to find a weight tensor's data by its hash, checked
+// before the cache directory (e.g. the server's own copy of the model file). Return true and
+// point *data / *size at the bytes whose ggml_backend_rpc_hash is `hash`. Set it before
+// starting the server; fn may be called from the server thread.
+typedef bool (*ggml_backend_rpc_cache_lookup_t)(uint64_t hash, const void ** data, size_t * size, void * user);
+GGML_BACKEND_API void ggml_backend_rpc_set_cache_lookup(ggml_backend_rpc_cache_lookup_t fn, void * user);
+// [distllm patch] The hash the client sends for tensor data (FNV-1a, 64-bit).
+GGML_BACKEND_API uint64_t ggml_backend_rpc_hash(const void * data, size_t size);
+// [distllm patch] Client: weight bytes sent to servers, and weight bytes the servers already
+// had (sent as a hash only), since the last reset.
+GGML_BACKEND_API void ggml_backend_rpc_get_upload_stats(uint64_t * sent, uint64_t * cached);
+GGML_BACKEND_API void ggml_backend_rpc_reset_upload_stats(void);
