 }
 
 // Try RPC_CMD_SET_TENSOR_HASH first when data size is larger than this threshold
-const size_t HASH_THRESHOLD = 10 * 1024 * 1024;
+// [distllm patch] 1 MiB, was 10 MiB: in the small models we use, almost every weight tensor is
+// under 10 MiB, so the cache skipped 66-99% of the bytes. Over 1 MiB covers ~99% of them
+// with about 140 hash round trips.
+const size_t HASH_THRESHOLD = 1 * 1024 * 1024;
+
+// [distllm patch] see ggml_backend_rpc_set_cache_lookup / ggml_backend_rpc_get_upload_stats
+static std::atomic<ggml_backend_rpc_cache_lookup_t> g_cache_lookup{nullptr};
+static std::atomic<void *>                          g_cache_lookup_user{nullptr};
+static std::atomic<uint64_t>                        g_upload_sent{0};
+static std::atomic<uint64_t>                        g_upload_cached{0};
+
+// [distllm patch] count weight uploads only (inputs are set during inference too)
+static void count_upload(const ggml_tensor * tensor, size_t size, bool cached) {
+    if (tensor->buffer && tensor->buffer->usage == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+        (cached ? g_upload_cached : g_upload_sent) += size;
+    }
+}
 
 // Maximum number of graphs cached per device; client and server must use the same value
 // so that both sides clear their caches at the same point in the message stream
@@ -586,6 +602,26 @@ static void rpc_record_failure(const std::string & endpoint) {
     }
 }
 
+// [distllm patch]
+void ggml_backend_rpc_set_cache_lookup(ggml_backend_rpc_cache_lookup_t fn, void * user) {
+    g_cache_lookup_user = user;
+    g_cache_lookup = fn;
+}
+
+uint64_t ggml_backend_rpc_hash(const void * data, size_t size) {
+    return fnv_hash((const uint8_t *) data, size);
+}
+
+void ggml_backend_rpc_get_upload_stats(uint64_t * sent, uint64_t * cached) {
+    if (sent)   *sent   = g_upload_sent;
+    if (cached) *cached = g_upload_cached;
+}
+
+void ggml_backend_rpc_reset_upload_stats(void) {
+    g_upload_sent   = 0;
+    g_upload_cached = 0;
+}
