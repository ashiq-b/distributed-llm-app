+// [distllm patch] A lost RPC server is reported instead of aborting the process.
+// Returns true if any client connection failed since the last clear, and copies
+// the first failed endpoint ("host:port") into endpoint_out (may be NULL).
+GGML_BACKEND_API bool ggml_backend_rpc_get_failure(char * endpoint_out, size_t size);
+GGML_BACKEND_API void ggml_backend_rpc_clear_failure(void);
