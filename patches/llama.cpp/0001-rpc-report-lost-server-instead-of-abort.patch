index e4a84cb..1bb1be8 100644
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -566,8 +566,40 @@ private:
     std::atomic_uint busy_spin_users = 0;
     std::atomic_bool running;
     std::thread      thread;
+
+public:
+    // [distllm patch] set when the connection to the server is lost
+    std::atomic_bool failed{false};
+    std::string      endpoint;
 };
 
+// [distllm patch] process-wide record of the first lost RPC server
+static std::mutex  g_rpc_failure_mu;
+static bool        g_rpc_failed = false;
+static std::string g_rpc_failed_endpoint;
+
+static void rpc_record_failure(const std::string & endpoint) {
+    std::lock_guard<std::mutex> lock(g_rpc_failure_mu);
+    if (!g_rpc_failed) {
+        g_rpc_failed          = true;
+        g_rpc_failed_endpoint = endpoint;
+    }
+}
+
+bool ggml_backend_rpc_get_failure(char * endpoint_out, size_t size) {
+    std::lock_guard<std::mutex> lock(g_rpc_failure_mu);
+    if (g_rpc_failed && endpoint_out && size > 0) {
+        snprintf(endpoint_out, size, "%s", g_rpc_failed_endpoint.c_str());
+    }
+    return g_rpc_failed;
+}
+
+void ggml_backend_rpc_clear_failure(void) {
+    std::lock_guard<std::mutex> lock(g_rpc_failure_mu);
+    g_rpc_failed = false;
+    g_rpc_failed_endpoint.clear();
+}
